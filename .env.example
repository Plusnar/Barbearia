DATABASE_HOST=seu-host-tidb
DATABASE_PORT=4000
DATABASE_NAME=barbearia
DATABASE_USER=seu-usuario
DATABASE_PASSWORD=sua-senha
DATABASE_SSL_MODE=VERIFY_IDENTITY
# Caminho local do certificado TiDB (dev) OU use DATABASE_CA no Vercel
DATABASE_CA_PATH=./backend/ca.pem
# No Vercel: cole o conteudo do ca.pem com quebras \\n
# DATABASE_CA=-----BEGIN CERTIFICATE-----\\n...\\n-----END CERTIFICATE-----
PORT=5000
NODE_ENV=production
JWT_SECRET=troque-por-uma-chave-segura-com-32-caracteres-ou-mais
CORS_ORIGIN=true
# Em producao, defina a URL exata do frontend (ex.: https://seu-app.vercel.app)
FRONTEND_URL=https://seu-app.vercel.app
PASSWORD_RESET_URL=https://seu-app.vercel.app
PASSWORD_RESET_TOKEN_MINUTES=30

# E-mail via Gmail API (OAuth2)
EMAIL_PROVIDER=gmail
EMAIL_FROM_NAME=Barbearia Castilho
EMAIL_FROM_ADDRESS=seu@gmail.com
GMAIL_CLIENT_ID=seu-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=seu-client-secret
GMAIL_REFRESH_TOKEN=seu-refresh-token
# Usado apenas ao gerar o refresh token localmente (npm run gmail:auth)
GMAIL_REDIRECT_URI=http://localhost:3333/oauth2callback

NOTIFICATION_TEST_API_KEY=uma-chave-para-testar-envios

# Banco: execute as migrations em database/migrations/ (001 a 005) no TiDB antes do deploy.
# Gmail: habilite Gmail API no Google Cloud e rode npm run gmail:auth uma vez para obter GMAIL_REFRESH_TOKEN.
# Vercel: configure todas as variaveis acima no painel Project Settings > Environment Variables.
# TiDB Cloud: libere acesso de rede publica ou use IPs estaticos do Vercel (plano pago).
